# Backend base URL used by the browser.
# Leave empty in development so requests stay same-origin and go through the Vite proxy.
# In production set it to the absolute API origin (e.g. https://api.example.com).
VITE_API_BASE_URL=

# Development only: where the Vite dev server forwards /api requests (Spring Boot).
# Not exposed to the browser bundle because it does not start with VITE_.
API_PROXY_TARGET=http://localhost:8080